<%- include('partials/header') %>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">HOMEMADE. HEARTFELT. ALWAYS A GOOD IDEA.</p>
    <h1>A little goodness,<br>in every <em>jar.</em></h1>
    <p>
      Small-batch nut butters for slow mornings,<br class="desktop">
      sweet little gifts, and everyday spoonfuls of joy.
    </p>
    <a class="button" href="/shop">
      Find your favorite <span aria-hidden="true">↗</span>
    </a>
    <div class="hero-note">
      <span class="tiny-flower">✳</span> Thoughtfully made. Happily shared.
    </div>
  </div>

  <div class="hero-art">
    <div class="arch">
      <img
        src="/images/butter.png"
        alt="Watercolor illustration of an open jar of nut butter"
      >
      <span class="round-stamp">
        SMALL BATCH<br>
        <b>Made with<br>love & care</b><br>
        BIG ON FLAVOR
      </span>
    </div>
    <p class="handwritten">Your toast’s new favorite.</p>
  </div>
</section>

<div class="values-strip">
  <span>Small-batch goodness</span>
  <b>✳</b>
  <span>Simple ingredients</span>
  <b>✳</b>
  <span>Made to be shared</span>
</div>

<section class="section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">MEET YOUR NEW PANTRY FAVORITES</p>
      <h2>Made for the good moments.</h2>
    </div>
    <a class="text-link" href="/shop">Shop all flavors ↗</a>
  </div>

  <div class="product-grid">
    <% products.filter(p => p.featured).forEach(product => { %>
      <%- include('partials/card', {product}) %>
    <% }) %>
  </div>
</section>

<section class="story-band">
  <div class="story-art">
    <img src="/images/bridge.png" alt="Watercolor stone bridge surrounded by trees">
  </div>
  <div>
    <p class="eyebrow">A BRIDGE TO SOMETHING GOOD</p>
    <h2>From our kitchen<br>to your happy place.</h2>
    <p>
      We believe the little things deserve a little extra care. A familiar flavor.
      A thoughtful gift. Something delicious to gather around.
    </p>
    <a class="text-link" href="/about">A little about Stonebridge ↗</a>
  </div>
</section>

<section class="closing">
  <p class="eyebrow">SPREAD A LITTLE JOY</p>
  <h2>For your pantry.<br>For your favorite people.</h2>
  <a class="button" href="/shop">Explore the pantry ↗</a>
  <img
    src="/images/nuts.png"
    alt="Watercolor peanuts, almonds, cashews, pistachios, and pecans"
  >
</section>

<%- include('partials/footer') %>
