<%- include('partials/header') %>

<section class="hero home-hero">
  <div class="hero-copy">
    <p class="eyebrow">NUTS. BLEND. EAT. REPEAT.</p>
    <h1>A little goodness<br>in every <em>jar.</em></h1>
    <p>
      Small-batch nut butters for spreading,<br class="desktop">
      sharing, and savoring every bite.
    </p>
    <a class="button" href="/shop">
      Find your favorite <span aria-hidden="true">↗</span>
    </a>
    <div class="hero-note">
      <span class="tiny-flower"><img src="/images/hand-drawn-sparkle%20(1).gif" alt="" width="48" height="48"></span> Smooth and Creamy Nut Butters
    </div>
  </div>

  <div class="hero-art hero-art-cutout">
    <div class="hero-photo hero-cutout-scene">
      <img
        class="hero-cutout"
        src="/images/hero-jar-spoon-cutout-v2.png"
        alt="Stonebridge peanut butter in a glass jar with a spoonful dripping into it"
        width="1536" height="1024" fetchpriority="high"
      >
      <span class="round-stamp">
        SMALL BATCH<br>
        <b>Made fresh<br>each week</b><br>
        BIG ON FLAVOR
      </span>
    </div>
  </div>
</section>

<div class="values-strip">
  <span>Small-batch goodness</span>
  <b><img src="/images/hand-drawn-sparkle%20(1).gif" alt="" width="48" height="48"></b>
  <span>Simple ingredients</span>
  <b><img src="/images/hand-drawn-sparkle%20(1).gif" alt="" width="48" height="48"></b>
  <span>Made to be shared</span>
</div>

<section class="section gingerbread-feature" aria-labelledby="gingerbread-title">
  <% const gingerbread = products.find(product => product.id === 'gingerbread'); %>
  <div class="gingerbread-feature-media">
    <img class="gingerbread-feature-jar" src="<%= gingerbread.photo %>" width="1536" height="1024" loading="lazy" decoding="async" alt="Color-edited image of Gingerbread Peanut Butter in its glass jar">
    <img class="gingerbread-feature-art" src="/images/gingerbread-spice-art-v1.png" width="1536" height="1024" loading="lazy" decoding="async" alt="" aria-hidden="true">
  </div>
  <div class="gingerbread-feature-copy">
    <p class="eyebrow">NEW FLAVOR · A COZY, SPICED SPOONFUL</p>
    <h2 id="gingerbread-title">Introducing Gingerbread<br>Cashew Peanut Butter.</h2>
    <p>Peanuts and cashews meet molasses, cinnamon, cloves, and ginger. A warm, spiced spoonful for toast, gifting, or enjoying straight from the jar.</p>
    <p><strong><%= money(gingerbread.sizes[0].price) %></strong> / 4 oz · <strong><%= money(gingerbread.sizes[1].price) %></strong> / 8 oz</p>
    <a class="button" href="/products/<%= gingerbread.slug %>">Order it now <span aria-hidden="true">↗</span></a>
    <p class="sample-label">Contains peanuts and cashews. Product image is color-edited.</p>
  </div>
</section>

<section class="story-band">
  <div class="story-art image-zoom">
    <img src="/images/coconut-board.png" loading="lazy" decoding="async" alt="Cutting board full of peanuts, coconut, and vanilla">
  </div>
  <div class="story-art image-zoom">
    <img src="/images/pistachio-board.png" loading="lazy" decoding="async" alt="Cutting board full of peanuts, pistachios, and macademias">
  </div>
</section>

<section class="story-band">
  <div>
    <p class="eyebrow">DELICIOUS FLAVOR</p>
    <h2>From our kitchen<br>to your happy place.</h2>
    <p>
      Try our carefully-crafted flavors of nut butter. We blend a variety of nuts and seeds with complementary flavor combinations. Something tasty for everyone to enjoy.
    </p>
    <a class="text-link" href="/about">A little about Stonebridge ↗</a>
  </div>
</section>

<section class="story-band">
  <div class="story-art">
    <video class="making-video" data-visible-loop muted loop playsinline preload="none" poster="/images/blender-landscape.png" aria-label="Watch Stonebridge nut butter being blended">
      <source data-src="/images/blender-video.mp4" type="video/mp4">
      Stonebridge nut butter being blended in small batches.
    </video>
  </div>
  <div>
    <p class="eyebrow">MADE FRESH</p>
    <h2>Small Batches<br>made to order.</h2>
    <p>
      Fresh ingredients. Always blended fresh for you.
    </p>
  </div>
</section>

<section class="closing">
  <p class="eyebrow">SPREAD A LITTLE JOY</p>
  <h2>For your pantry.<br>For your favorite people.</h2>
  <a class="button" href="/shop">Explore the pantry ↗</a>
  <img
    src="/images/nuts.png"
    loading="lazy" decoding="async"
    alt="Watercolor peanuts, almonds, cashews, pistachios, and pecans"
  >
</section>

<%- include('partials/footer') %>
