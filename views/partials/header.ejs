<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="Discover Stonebridge Nut Butters: small-batch homemade peanut butter and specialty flavors."
    >
    <% if (page === 'confirmation') { %><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><% } %>
    <title><%= title %> | Stonebridge Nut Butters</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/product-sizes.js" defer></script>
    <script src="/js/navigation.js" defer></script>
    <script src="/js/motion.js" defer></script>
    <script src="/js/cart-state.js" defer></script>
    <script src="/js/cart.js" defer></script>
  </head>
  <body class="page-<%= page %>">
    <div class="announcement">
      Small batches. Simple pleasures. A little something to savor.
    </div>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Stonebridge Nut Butters home">
        <span>
          <img src="/images/logo.png" alt="" width="152" height="94">
        </span>
      </a>

      <div class="nav-panel" id="navigation-panel">
        <nav aria-label="Main navigation">
          <div class="nav-links">
            <a class="nav-icon-link" href="/" aria-label="Home" <%- page === 'home' ? 'aria-current="page"' : '' %>><%- include('nav-icon', { icon: 'home' }) %><span class="nav-label" aria-hidden="true">Home</span></a>
            <a class="nav-icon-link" href="/shop" aria-label="Shop" <%- page === 'shop' ? 'aria-current="page"' : '' %>><%- include('nav-icon', { icon: 'shop' }) %><span class="nav-label" aria-hidden="true">Shop</span></a>
            <a class="nav-icon-link" href="/about" aria-label="Our story" <%- page === 'about' ? 'aria-current="page"' : '' %>><%- include('nav-icon', { icon: 'about' }) %><span class="nav-label" aria-hidden="true">Our story</span></a>
            <a class="nav-icon-link" href="/faq" aria-label="FAQ" <%- page === 'faq' ? 'aria-current="page"' : '' %>><%- include('nav-icon', { icon: 'faq' }) %><span class="nav-label" aria-hidden="true">FAQ</span></a>
          </div>
        </nav>
      </div>
      <a class="basket-link nav-icon-link" href="/cart" aria-label="Shopping cart" <%- page === 'cart' ? 'aria-current="page"' : '' %>>
        <%- include('nav-icon', { icon: 'cart' }) %>
        <span class="nav-label" aria-hidden="true">Cart</span>
        <span data-cart-count class="count">0</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="navigation-panel" aria-expanded="false" hidden>
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path class="menu-top" d="M4 6h16"/><path class="menu-middle" d="M4 12h16"/><path class="menu-bottom" d="M4 18h16"/>
        </svg>
      </button>
    </header>

    <main id="main">
