<div
  class="jar-scene <%= product.color %>"
  role="img"
  aria-label="Illustrated placeholder jar of <%= product.name %>"
>
  <div class="jar">
    <div class="lid"></div>
    <div class="jar-label">
      <img src="/images/bridge.png" alt="">
      <span class="jar-brand">STONEBRIDGE</span>
      <span class="jar-sub">NUT BUTTERS</span>
      <strong><%= product.name %></strong>
      <span class="jar-small">SMALL BATCH · MADE WITH CARE</span>
    </div>
  </div>
  <img class="jar-nuts" src="/images/nuts.png" alt="">
</div>
