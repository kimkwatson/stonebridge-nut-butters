<%- include('partials/header') %>

<section class="page-intro">
  <p class="eyebrow">GOOD THINGS, GATHERED</p>
  <h1>Your cart.</h1>
  <b><img src="/images/nut-butter-spoon.gif" alt="" width="175" height="175"></b>
  <p>A little goodness to look forward to.</p>
</section>

<section class="section cart-section">
  <div id="cart-items" aria-live="polite">
    <p>Loading your basket…</p>
  </div>

  <aside class="cart-summary">
    <h2>A happy little haul.</h2>
    <div class="subtotal">
      <span>Subtotal</span>
      <strong id="cart-subtotal">$0.00</strong>
    </div>
    <form id="fulfillment-form" class="fulfillment-form">
      <label for="fulfillment-method">How would you like your jars?</label>
      <select id="fulfillment-method" name="method" required>
        <option value="">Choose shipping or pickup</option>
        <option value="shipping">Arizona shipping — $7.95 per order</option>
        <option value="pickup">Mesa pickup — free</option>
      </select>
      <fieldset id="shipping-fields" hidden disabled>
        <legend>Delivery address — Arizona only</legend>
        <label for="shipping-name">Recipient name</label><input id="shipping-name" name="recipient" autocomplete="shipping name" maxlength="100" required>
        <label for="shipping-line1">Street address</label><input id="shipping-line1" name="line1" autocomplete="shipping address-line1" maxlength="200" required>
        <label for="shipping-line2">Apartment or suite (optional)</label><input id="shipping-line2" name="line2" autocomplete="shipping address-line2" maxlength="200">
        <label for="shipping-city">City</label><input id="shipping-city" name="city" autocomplete="shipping address-level2" maxlength="100" required>
        <label for="shipping-state">State</label><select id="shipping-state" name="state" autocomplete="shipping address-level1"><option value="AZ">Arizona</option></select>
        <label for="shipping-postal">ZIP code</label><input id="shipping-postal" name="postal" autocomplete="shipping postal-code" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" required>
      </fieldset>
      <p id="fulfillment-note">Arizona delivery is $7.95 per order. Pickup in Mesa is free.</p>
    </form>
    <div class="subtotal"><span>Shipping / pickup</span><strong id="cart-shipping">Choose above</strong></div>
    <div class="subtotal"><span>Total before tax</span><strong id="cart-total">$0.00</strong></div>
    <p id="checkout-mode-note">Checking payment availability…</p>
    <p>Tax is not currently calculated by this checkout.</p>
    <button id="checkout-button" class="button" type="button" disabled>Secure checkout</button>
    <p id="checkout-status" role="status" aria-live="polite">Checking payment availability…</p>
    <a class="text-link" href="/shop">Keep exploring ↗</a>
  </aside>
</section>

<%- include('partials/footer') %>
