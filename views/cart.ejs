<%- include('partials/header') %>

<section class="page-intro">
  <p class="eyebrow">GOOD THINGS, GATHERED</p>
  <h1>Your basket.</h1>
  <p>A little goodness to look forward to.</p>
</section>

<section class="section cart-section">
  <div id="cart-items" aria-live="polite">
    <p>Loading your basket…</p>
  </div>

  <aside class="cart-summary">
    <h2>A happy little haul.</h2>
    <div class="subtotal">
      <span>Subtotal</span>
      <strong id="cart-subtotal">$0.00</strong>
    </div>
    <p>Sandbox only: sample products and prices. Shipping and tax are excluded from this test.</p>
    <button id="checkout-button" class="button" type="button" disabled>Try test checkout</button>
    <p id="checkout-status" role="status" aria-live="polite">No real payments or orders. Use a Stripe test card only.</p>
    <a class="text-link" href="/shop">Keep exploring ↗</a>
  </aside>
</section>

<%- include('partials/footer') %>
