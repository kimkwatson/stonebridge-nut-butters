<%- include('partials/header') %>

<section class="page-intro">
  <p class="eyebrow">GOOD THINGS, GATHERED</p>
  <h1>Your basket.</h1>
  <p>A little goodness to look forward to.</p>
</section>

<section class="section cart-section">
  <div id="cart-items" aria-live="polite">
    <p>Loading your basket…</p>
  </div>

  <aside class="cart-summary">
    <h2>A happy little haul.</h2>
    <div class="subtotal">
      <span>Subtotal</span>
      <strong id="cart-subtotal">$0.00</strong>
    </div>
    <p>Shipping and taxes are not calculated in this demo.</p>
    <button class="button" disabled>Checkout coming soon</button>
    <p>We’re still setting the table. Payments and ordering are not yet available.</p>
    <a class="text-link" href="/shop">Keep exploring ↗</a>
  </aside>
</section>

<%- include('partials/footer') %>
