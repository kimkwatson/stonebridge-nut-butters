<%- include('partials/header') %>

<section class="section">
  <a class="text-link" href="/shop">← Back to the pantry</a>

  <div class="product-detail">
    <div class="product-photo-stage product-detail-photo<%= product.id === 'gingerbread' ? ' product-detail-photo-gingerbread' : '' %>" data-detail-photo>
      <img src="<%= product.photo %>" alt="<%= product.name %> in its glass jar with a silver lid" width="1536" height="1024" decoding="async">
    </div>

    <div>
      <p class="eyebrow"><%= product.tag %></p>
      <h1><%= product.name %></h1>
      <p><%= product.description %></p>

      <form data-add-to-cart data-product-id="<%= product.id %>">
        <label for="size">Choose a size</label>
        <select id="size" name="size">
          <% product.sizes.forEach(size => { %>
            <option value="<%= size.id %>">
              <%= size.label %> — <%= money(size.price) %>
            </option>
          <% }) %>
        </select>

        <label for="quantity">Quantity</label>
        <input
          id="quantity"
          name="quantity"
          type="number"
          value="1"
          min="1"
          max="99"
          required
        >
        <button class="button" type="submit">Add to basket ↗</button>
      </form>

      <details open>
        <summary>Ingredients & allergens</summary>
        <p><%= product.ingredients %></p>
        <p>
          Contains: <%= product.allergens %>. These are sample details; final recipes and
          cross-contact information must be confirmed before ordering.
        </p>
      </details>

      <p class="sample-label"><%= product.imageEdited ? 'Color-edited product image based on our jar photography.' : 'Our product photography with the background removed.' %></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
